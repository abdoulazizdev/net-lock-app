{
  "expo": {
    "name": "NetOff",
    "slug": "netoff",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/netoff_icon.png",
    "scheme": "netoff",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netoff.app",
      "icon": "./assets/icons/netoff_icon.png",
      "buildNumber": "27",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Utilisé pour sécuriser l'accès à l'application."
      }
    },
    "android": {
      "package": "com.netoff.app",
      "versionCode": 27,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "INTERNET",
        "BIND_VPN_SERVICE",
        "QUERY_ALL_PACKAGES",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive_icon.png",
        "backgroundColor": "#08090C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "netoff"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/netoff_icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/netoff_icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#08090C",
          "dark": {
            "backgroundColor": "#08090C"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31d284c3-e169-4330-ae67-367c2a8eed64"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
